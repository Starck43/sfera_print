    "html-react-parser": "^6.1.9",
    "next": "^16.4.6",
    "next-video": "^2.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intersection-observer": "^11.0.1",
    "react-vertical-timeline-component": "^4.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "swiper": "^14.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@svgr/webpack": "^8.1.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
