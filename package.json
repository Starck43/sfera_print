    "@types/react-dom": "^19.3.0",
    "@types/react-vertical-timeline-component": "^3.3.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.11.36",
    "critters": "^0.0.25",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "^5.9.3"
  },
  "resolutions": {},
  "overrides": {
    "postcss": "8.5.10",
    "react-intersection-observer": "^11.0.1",
    "zod-validation-error": "^4.0.2",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "sharp": true,
    "react-vertical-timeline-component": true,
    "unrs-resolver": true
  }
