# Пример файла окружения. Скопируйте его в .env и заполните своими значениями.
# Файл .env не должен попадать в git.

# Локальный сервер
SERVER=localhost
URL=http://localhost:3000

# API бэкенда
API_SERVER=http://localhost:8000
NEXT_PUBLIC_API_SERVER=http://localhost:8000

# Секретный токен для серверных запросов
SECRET_TOKEN=change-me

# Bitrix24 REST
BITRIX24_REST_ENDPOINT=https://<your-portal>.bitrix24.ru/rest
BITRIX24_TOKEN=<your-access-token>

# Виджет CRM-формы Bitrix24 (значения можно взять в настройках CRM-формы)
NEXT_PUBLIC_BITRIX_FORM_SRC=https://<your-portal>.bitrix24.ru/upload/crm/form/loader_XX.js
NEXT_PUBLIC_BITRIX_FORM_DATA=inline/XX/XXXXXXXX

# Счётчики
NEXT_PUBLIC_MAILRU_ID=
NEXT_PUBLIC_YANDEX_ID=

# Карусель на главной странице
CIRCLE_CAROUSEL_SLIDES_COUNT=5
CIRCLE_CAROUSEL_SLIDE_DURATION=4000

# Включает отчёт бандл-анализатора при сборке
# ANALYZE=true
